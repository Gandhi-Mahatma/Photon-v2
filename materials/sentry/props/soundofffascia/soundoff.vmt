"VertexlitGeneric"
{
	"$basetexture" "sentry/props/soundofffascia/soundoff"
	"$bumpmap" "sentry/props/soundofffascia/soundoff_nm"
	"$alphatest" "1"
	"$allowalphatocoverage" "1"
    $phong "1"
    $phongexponent "5"
    $phongboost "1"
    $phongfresnelranges "[.05 .8 1]"
	"$rimlight"               "1"
	"$rimlightexponent"       "17"
